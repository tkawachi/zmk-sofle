#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#include <input/processors.dtsi>

/*

   &mmv_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

   &msc_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

 */

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10


/ {
    macros {
        muhenkan: muhenkan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LANG2>
                , <&macro_release &kp LANG2>
                , <&macro_press &kp INT_MUHENKAN>
                , <&macro_release &kp INT_MUHENKAN>
                ;
        };
        henkan: henkan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LANG1>
                , <&macro_release &kp LANG1>
                , <&macro_press &kp INT_HENKAN>
                , <&macro_release &kp INT_HENKAN>
                ;
        };
        // window screenshot for macOS
        w_scrshot: window_screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_press &kp LSHFT>
                , <&macro_press &kp LEFT_GUI>
                , <&macro_press &kp N4>
                , <&macro_tap &kp SPACE>
                , <&macro_release &kp N4>
                , <&macro_release &kp LEFT_GUI>
                , <&macro_release &kp LSHFT>
                , <&macro_release &kp LCTRL>
                ;
        };
    };

    behaviors {
        mmv {
            acceleration-exponent = <1>;      // 1
            time-to-max-speed-ms = <900>;    // 40
            delay-ms = <0>;                   // 0
        };

        msc {
            acceleration-exponent = <1>;      // 0
            time-to-max-speed-ms = <400>;      // 500
            delay-ms = <0>;                   //   10
        };

        mo_1: mo_1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&muhenkan>;
        };
        mo_2: mo_2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&henkan>;
        };

        lbr: left_brace {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LBKT>, <&kp LBRC>;
        };
        rbr: right_brace {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RBKT>, <&kp RBRC>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp GRAVE   &kp N1     &kp N2        &kp N3        &kp N4  &kp N5       &mmv MOVE_UP     &kp N6     &kp N7     &kp N8     &kp N9           &kp N0      &kp BACKSPACE
&kp TAB     &kp Q      &kp W         &kp E         &kp R   &kp T        &mmv MOVE_DOWN   &kp Y      &kp U      &kp I      &kp O            &kp P       &kp BSLH
&kp LCTRL   &kp A      &kp S         &kp D         &kp F   &kp G        &mmv MOVE_LEFT   &kp H      &kp J      &kp K      &kp L            &kp SEMI    &kp ENTER
&mt LSHFT ESC &kp Z    &kp X         &kp C         &kp V   &kp B        &mmv MOVE_RIGHT  &kp N      &kp M      &kp COMMA  &kp DOT          &kp FSLH    &mt RSHFT APOS
&mkp RCLK   &kp LEFT_ALT &kp LEFT_GUI &mo_1 1 0    &kp SPACE &kp LC(LS(LG(N4)))  &mkp LCLK        &kp BACKSPACE &kp SPACE &mo_2 2 0        &mt RCMD DOWN_ARROW &mt RALT UP_ARROW
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "LAYER0";
        };

        layer_1 {
            bindings = <
&trans      &kp F1           &kp F2          &kp F3           &kp F4           &kp F5             &mmv MOVE_UP     &kp F6           &kp F7           &kp F8      &kp F9     &kp F10           &kp DELETE
&kp TILDE   &kp EXCL         &kp AT          &kp HASH         &kp DLLR         &kp PRCNT          &mmv MOVE_DOWN   &kp CARET        &kp AMPS         &kp STAR    &kp LPAR   &kp RPAR          &kp EQUAL
&trans      &kp LEFT_ARROW   &kp DOWN_ARROW  &kp UP_ARROW     &kp RIGHT_ARROW  &mkp MB5           &mmv MOVE_LEFT   &kp EQUAL        &kp MINUS        &kp PLUS    &lbr       &rbr              &trans
&trans      &kp HOME         &kp PG_DN       &kp PG_UP        &kp END          &rgb_ug RGB_SPI    &mmv MOVE_RIGHT  &kp UNDER        &rgb_ug RGB_BRD  &kp INSERT  &kp F11    &kp F12           &trans
&kp C_MUTE  &trans           &trans          &trans           &trans           &w_scrshot         &mkp LCLK        &trans           &trans           &trans      &trans     &trans
            >;

            display-name = "layer1";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_2 {
            bindings = <
&trans     &kp C_BRI_DN  &kp C_BRI_UP    &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS &kp C_AC_SEARCH &trans &mmv MOVE_UP &trans  &trans  &trans &trans &trans       &trans
&kp GRAVE  &kp LG(LBKT)  &kp LG(RBKT)    &trans        &trans        &trans          &mmv MOVE_DOWN   &trans  &kp N7 &kp N8 &kp N9  &kp N0    &kp PLUS
&kp F1     &kp F2        &kp F3          &kp F4        &kp F5        &kp F6          &mmv MOVE_LEFT   &trans  &kp N4 &kp N5 &kp N6  &kp LBRC     &kp RBRC
&kp F7     &kp F8        &kp F9          &kp F10       &kp F11       &kp F12         &mmv MOVE_RIGHT  &trans  &kp N1 &kp N2 &kp N3  &bootloader  &trans
&trans     &trans        &trans          &trans        &trans        &kp LS(LG(N4))          &mkp LCLK        &trans  &trans  &trans      &kp C_PLAY_PAUSE     &kp C_MUTE
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        layer_3 {
            bindings = <
&trans     &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &mmv MOVE_UP     &kp F6  &kp F7  &kp F8      &kp F9     &kp F10      &trans
&trans     &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans          &mmv MOVE_DOWN   &trans  &kp N7  &kp N8      &kp N9     &kp N0       &kp PLUS
&trans     &out OUT_USB  &out OUT_BLE    &trans        &trans        &trans          &mmv MOVE_LEFT   &trans  &kp N4  &kp N5      &kp N6     &kp LBRC     &kp RBRC
&trans     &sys_reset    &trans          &bootloader   &trans        &trans          &mmv MOVE_RIGHT  &trans  &kp N1  &kp N2      &kp N3     &bootloader  &trans
&trans     &trans        &trans          &trans        &trans        &trans          &mkp LCLK        &trans  &trans  &trans      &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

    };
};
